# /etc/sudoers.d/hw-assistant  (generated by install_sudoers.sh; validated with visudo -c)
# Grants ONE user passwordless root for exactly ONE read-only command with EXACT arguments.
# sudoers matches arguments literally, so `dmidecode -t memory; rm -rf /` or `dmidecode -s ...` is refused.
__USER__ ALL=(root) NOPASSWD: __DMIDECODE__ -t memory
